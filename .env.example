# All settings are optional.
# The default server is localhost-only at http://127.0.0.1:8788.

# Change the local port.
# MCP_PORT=8788

# Add a per-call PIN for /mcp tools before exposing the ChatGPT endpoint.
# MCP_PUBLIC_PIN=<short-lived-pin>

# Add bearer auth for /mcp-codex before using it outside a trusted localhost session.
# MCP_CODEX_TOKEN=<long-random-token>

# Add extra browser origins, comma-separated.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Store the auto-generated project registry somewhere else.
# MCP_PROJECTS_FILE=/absolute/path/to/projects.local.json
# MCP_DEFAULT_PROJECT_ID=my-project

# Tune bounded reads/searches.
# MCP_MAX_READ_BYTES=120000
# MCP_MAX_DIFF_BYTES=200000
# MCP_MAX_GREP_RESULTS=100

# ChatGPT Web Pro extension automation.
# Default is playwright-chrome via a local Chrome DevTools Protocol port.
# Use mock only for automated tests.
# MCP_PRO_BROWSER_MODE=playwright-chrome
# MCP_PRO_MODEL_LABEL=Pro 拡張
# MCP_PRO_CHROME_AUTOMATION_USER_DATA_DIR=/Users/you/.codex-gptpro/chrome-user-data
# MCP_PRO_CHROME_PROFILE_DIRECTORY=codex-gptpro
# MCP_PRO_CDP_PORT=29333
# MCP_PRO_CDP_ENDPOINT=http://127.0.0.1:29333
# MCP_PRO_ALLOW_CHROME_RESTART=false
# MCP_PRO_FORCE_CHROME_RESTART=false
# MCP_PRO_KEEP_BROWSER_OPEN=false
# MCP_PRO_MOCK_RESPONSE=codex-gptpro pro mock response

# Chrome 136+ ignores remote debugging for the default Chrome data directory.
# Set this only for explicit experiments; it is not the recommended default.
# MCP_PRO_USE_SYSTEM_CHROME_PROFILE=false

# Development escape hatch only. Prefer leaving this unset.
# MCP_INSECURE_PUBLIC_NO_PIN=false
